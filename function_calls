const chatbotDb = new sqlite3.Database('./chatbot.db', (err) => {
  if (err) {
    console.error('Error opening chatbot database', err.message);
  } else {
    console.log('Connected to the chatbot SQLite database');
    
    // Create chat_history table
    chatbotDb.run(`
      CREATE TABLE IF NOT EXISTS chat_history (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        user_id TEXT,
        message TEXT NOT NULL,
        response TEXT NOT NULL,
        timestamp TIMESTAMP DEFAULT CURRENT_TIMESTAMP
      )
    `, (err) => {
      if (err) {
        console.error('Error creating chat_history table', err.message);
      } else {
        console.log('Chat history table initialized');
      }
    });
  }
});

